{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "electron.vite.config.*",
        "src/main/**/*",
        "src/main/global-types.d.ts",
        "src/preload/global.ts",
        "src/main/menu/*.ts",
      "src/renderer/src/components/dialogs/**/*.ts",
        "resources/themes/**/*.ts",
        "resources/katex/types/**/*.ts",
        "resources/mermaid/**/*.ts",
        "resources/monaco-editor/**/*.ts",
        "resources/themes/*.ts",
        "resources/katex/*.js",
        "resources/katex/*.mjs",
        "resources/mermaid/**/*.ts",
        "resources/mermaid/**/*.js",
        "resources/mermaid/**/*.mjs",
        "resources/monaco-editor/**/*.nls.js",
        "resources/monaco-editor/**/*.js",
        "resources/monaco-editor/**/*.ts",
        "resources/monaco-editor/min/vs/editor/*.nls.js",
        "resources/themes/monaco-themes/**/*.ts",
        "resources/themes/monaco-themes/**/*.js",
        "src/main/templates/writing/*.ts",
        "src/main/templates/textblock/*.ts",
        "src/main/templates/textblock/*.js",
        "src/main/templates/textblock/*.html",
        "src/main/templates/plantuml/*.ts",
        "src/main/templates/mermaid/*.ts",
        "src/main/themes/monaco-themes/**/*.ts",
        "src/main/themes/monaco-themes/*.js",
        "src/main/plugins/**/*.ts",
        "src/main/plugins/*.ts",
        "src/main/utils/*.ts",
        "src/main/utils/*.js",
        "src/preload/**/*"],
    "compilerOptions": {
        "composite": true,
        "target": "ES6",
        "module": "NodeNext",
        "strict": false,
        "esModuleInterop": true,
        "allowJs": true,
        "moduleResolution": "NodeNext",
        "types": ["electron-vite/node"]
    }
}

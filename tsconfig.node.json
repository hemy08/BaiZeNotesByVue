{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "electron.vite.config.*",
        "src/main/**/*.ts",
        "src/main/**/*.js",
        "src/preload/**/*"
    ],
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "allowJs": true,
        "moduleResolution": "NodeNext",
        "types": ["electron-vite/node"]
    }
}

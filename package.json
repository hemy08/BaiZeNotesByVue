{
    "name": "baize-notes",
    "version": "1.5.1",
    "private": true,
    "description": "白泽笔记（BaiZeNotes）：基于 Electron + Vue 3 + Monaco 的本地 Markdown 笔记与预览桌面应用",
    "main": "./out/build/main/index.js",
    "author": "hemy08",
    "license": "MIT",
    "email": "zhaojunwei008@yeah.net",
    "repo": "https://github.com/hemy08/BaiZeNotesByVue.git",
    "homepage": "https://github.com/hemy08/BaiZeNotesByVue",
    "packageManager": "npm@11.20.0",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.9.0"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "typecheck:node": "node --max-old-space-size=8192 --stack-size=4096 node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck:test": "node --max-old-space-size=8192 node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.test.json --composite false",
        "typecheck:e2e": "node --max-old-space-size=8192 node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.e2e.json",
        "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test && npm run typecheck:e2e",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "start": "electron-vite preview",
        "generate-version": "node build/generate-version-config.js",
        "generate-preload-whitelist": "node build/generate-preload-whitelist.js",
        "quality:baseline": "node build/generate-quality-baseline.js",
        "quality:check": "node build/generate-quality-baseline.js --check",
        "docs:check": "node build/check-doc-links.js",
        "budget:check": "node build/check-bundle-budget.js",
        "perf:baseline": "node build/perf-baseline.js",
        "perf:ci": "node build/perf-ci.js",
        "perf:ci:startup": "node build/perf-ci.js --startup",
        "perf:snapshot": "node build/perf-ci.js --update-snapshot",
        "memory:check": "node build/check-memory-lifecycle.js",
        "arch:check": "vitest run tests/architecture",
        "dev": "npm run generate-version && npm run generate-preload-whitelist && electron-vite dev",
        "build": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --dir",
        "build:win": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --win --x64",
        "build:mac": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && electron-builder --mac",
        "build:linux": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && electron-builder --linux",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --dir",
        "build:unpack:e2e": "npm run build:unpack && node build/verify-packaged-fuses.js && node build/e2e-enable-inspect.js",
        "verify:pack": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --dir",
        "verify:fuses": "node build/verify-packaged-fuses.js",
        "build:win:all": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --win nsis --x64 && node build/prepare-build-dirs.js && electron-builder --win portable --x64",
        "build:win:portable": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --win portable",
        "build:win:zip": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --win zip",
        "build:win:nsis": "npm run generate-version && npm run generate-preload-whitelist && electron-vite build && node build/prepare-build-dirs.js && electron-builder --win nsis",
        "audit": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
        "audit:prod": "npm audit --registry=https://registry.npmjs.org --omit=dev --audit-level=high",
        "audit:all": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
        "clean": "node -e \"const fs=require('fs');for(const d of ['node_modules','out','dist','coverage','test-results','playwright-report'])fs.rmSync(d,{recursive:true,force:true})\"",
        "lint:fix": "eslint . --fix",
        "test:e2e": "playwright test",
        "test:e2e:list": "playwright test --list"
    },
    "dependencies": {
        "@electron-toolkit/utils": "^4.0.0",
        "csv-parser": "^3.2.1",
        "electron-store": "^12.0.0",
        "electron-updater": "^6.8.11",
        "fs-extra": "^11.4.1",
        "iconv-lite": "^0.7.3",
        "jschardet": "^4.1.0",
        "mammoth": "^1.13.0",
        "markdown-it": "^15.0.3",
        "officegen": "^0.6.5",
        "turndown": "^7.2.5"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^4.0.0",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@imengyu/vue3-context-menu": "^1.5.7",
        "@playwright/test": "^1.65.1",
        "@types/fs-extra": "^11.0.4",
        "@types/markdown-it-emoji": "^3.0.1",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-v8": "^5.1.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.6.0",
        "crypto-js": "^4.2.0",
        "dompurify": "3.4.18",
        "electron": "^43.8.12",
        "electron-builder": "^26.18.1",
        "electron-vite": "^6.0.0",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "highlight.js": "^11.12.0",
        "jsdom": "^29.1.1",
        "katex": "^0.18.10",
        "markdown-it-emoji": "^3.1.0",
        "markdown-it-highlightjs": "^4.1.0",
        "markdown-it-plantuml": "^1.4.1",
        "mermaid": "^12.3.0",
        "monaco-editor": "^0.57.0",
        "pdfjs-dist": "^6.5.438",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "ulid": "^3.0.2",
        "uuid": "^14.0.3",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "vue": "^3.5.46",
        "vue-tsc": "^3.3.14"
    },
    "overrides": {
        "@babel/core": "^7.29.13",
        "baseline-browser-mapping": "^2.11.37",
        "browserslist": "^4.29.5",
        "dompurify": "3.4.18",
        "@xmldom/xmldom": "^0.8.15",
        "fast-uri": "^3.1.9",
        "js-yaml": "^4.3.2",
        "postcss-selector-parser": "^6.1.6",
        "@electron/get": {
            "undici": "^7.30.1"
        },
        "jsdom": {
            "undici": "^7.30.1"
        },
        "node-gyp": {
            "undici": "^6.29.1"
        },
        "js-beautify": {
            "glob": "^14.0.6"
        },
        "editorconfig": {
            "minimatch": "^11.0.9"
        },
        "minimatch@^3.0.0": {
            "brace-expansion": "^1.1.22"
        },
        "minimatch@^10.0.0": {
            "brace-expansion": "^5.0.13"
        },
        "app-builder-lib": {
            "minimatch": "^11.0.9"
        },
        "@electron/universal": {
            "minimatch": "^11.0.9"
        },
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.9"
        },
        "archiver-utils": {
            "glob": {
                "minimatch": {
                    "brace-expansion": "^1.1.22"
                }
            }
        },
        "readdir-glob": {
            "minimatch": {
                "brace-expansion": "^2.1.8"
            }
        }
    }
}

{
    "name": "baize-notes",
    "version": "1.2.2",
    "description": "An Electron application with Vue and TypeScript",
    "main": "./out/main/index.js",
    "author": "hemy08",
    "email": "zhaojunwei008@yeah.net",
    "repo": "https://github.com/hemy08/BaiZeNotesByVue.git",
    "homepage": "https://electron-vite.org",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
        "typecheck:node": "node --max-old-space-size=8192 --stack-size=4096 node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "start": "electron-vite preview",
        "copy": ".\\build\\copyfile.bat",
        "generate-version": "node build/generate-version-config.js",
        "dev": "npm run generate-version && electron-vite dev",
        "build": "npm run generate-version && electron-vite build && electron-builder --dir",
        "build:win": "npm run generate-version && electron-vite build && electron-builder --win --x64",
        "build:mac": "npm run generate-version && electron-vite build && electron-builder --mac",
        "build:linux": "npm run generate-version && electron-vite build && electron-builder --linux",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run generate-version && electron-vite build && electron-builder --dir",
        "build:win:all": "npm run generate-version && electron-vite build && electron-builder --win nsis --x64 && electron-builder --win portable --x64",
        "build:win:portable": "npm run generate-version && electron-vite build && electron-builder --win portable",
        "build:win:zip": "npm run generate-version && electron-vite build && electron-builder --win zip",
        "build:win:nsis": "npm run generate-version && electron-vite build && electron-builder --win nsis",
        "rebuild": "electron-rebuild -f -w sqlite3",
        "clean": "rmdir /s /q node_modules && rmdir /s /q out && rmdir /s /q dist"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@imengyu/vue3-context-menu": "^1.5.6",
        "app-builder-bin": "^4.2.0",
        "commonmark": "^0.31.2",
        "crypto-js": "^4.2.0",
        "csv-parser": "^3.2.1",
        "detect-file-encoding-and-language": "^2.4.0",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.8.9",
        "encoding": "^0.1.13",
        "fs-extra": "^11.4.0",
        "highlight.js": "^11.12.0",
        "iconv-lite": "^0.7.3",
        "jschardet": "^3.1.3",
        "jsdom": "^29.1.1",
        "katex": "^0.18.4",
        "mammoth": "^1.12.1",
        "markdown-it": "^15.0.0",
        "markdown-it-anchor": "^9.2.1",
        "markdown-it-emoji": "^3.1.0",
        "markdown-it-highlightjs": "^4.1.0",
        "markdown-it-plantuml": "^1.4.1",
        "mermaid": "^11.17.0",
        "monaco-editor": "^0.56.0",
        "monaco-themes": "^0.4.8",
        "node-forge": "^1.3.1",
        "officegen": "^0.6.5",
        "plantuml-cli": "^1.2024.5",
        "turndown": "^7.2.0",
        "ulid": "^3.0.2",
        "uuid": "^14.0.2",
        "vue": "^3.5.41",
        "vuex": "^4.1.0"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.1.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@rushstack/eslint-patch": "^1.10.3",
        "@types/fs-extra": "^11.0.4",
        "@types/jsdom": "^30.0.0",
        "@types/markdown-it-emoji": "^3.0.1",
        "@types/node": "^22.0.0",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "electron": "^43.0.0",
        "electron-builder": "^26.0.0",
        "electron-vite": "^6.0.0-beta.1",
        "eslint": "^9.39.4",
        "eslint-plugin-vue": "^9.33.0",
        "png-to-ico": "^3.0.2",
        "prettier": "^3.9.6",
        "sharp": "^0.35.3",
        "typescript": "^6.0.2",
        "vite": "^8.2.2",
        "vite-plugin-copy": "^0.1.6",
        "vite-plugin-monaco-editor": "^1.1.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    }
}
